{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthConnection": "Host=localhost;Database=trading_db;Username=postgres;Password=password",
    "DefaultConnection": "Host=localhost;Database=trading_db;Username=postgres;Password=password"
  },
  "CandleCache": {
    "Enabled": true,
    "LatestTtl": "00:00:30",
    "HistoricalTtl": "01:00:00",
    "UseLocalCache": true
  },
  "AdminConfigurations": {
    "UserName": "admin",
    "Role": "Administrator"
  },
  "JwtConfigurations": {
    "Issuer": "TradePulseApi",
    "Audience": "TradePulseClient",
    "DurationInMinutes": 30
  }
}
