<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Binance.Net" Version="13.8.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cTrader Open API (Pepperstone) speaks protobuf; the messages are Spotware's own .proto files, compiled at build time. -->
    <Protobuf Include="Exchange\Ctrader\Protocol\*.proto" ProtoRoot="Exchange\Ctrader\Protocol" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- SignInManager and friends come from the shared framework; the old 2.x Microsoft.AspNetCore.Identity package dragged in vulnerable Cryptography.Xml/Pkcs. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Infrastructure.UnitTests" />
    <InternalsVisibleTo Include="CtraderCheck" />
  </ItemGroup>

</Project>
