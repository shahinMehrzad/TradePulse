<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TradePulse</title>
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" asp-append-version="true" />
</head>
<body>
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <a class="navbar-brand d-flex align-items-center gap-2 text-primary" asp-page="/Index"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg><span class="text-body fw-bold">TradePulse</span></a>
                <ul class="navbar-nav flex-row me-auto ms-4">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Series">Collector series</a></li>
                </ul>
                <div class="navbar-nav flex-row order-md-last align-items-center">
                    <span class="nav-link text-secondary">@User.Identity?.Name</span>
                    <form method="post" asp-page="/Logout" class="ms-2">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                    </form>
                </div>
            </div>
        </header>
        <div class="page-wrapper">
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <h2 class="page-title">@ViewData["Title"]</h2>
                </div>
            </div>
            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/tabler/js/tabler.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
