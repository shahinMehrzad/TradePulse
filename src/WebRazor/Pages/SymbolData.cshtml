@page
@model SymbolDataModel
@{
    ViewData["Title"] = "Funding rate & liquidations";
}

<div class="alert alert-info" role="alert">
    The funding rate and liquidations have no time frame, so they are chosen per symbol here instead of per candle series. Both exist on futures only.
    The worker reads this list when it starts, so a change applies after the worker is restarted. Liquidations have no history: they are recorded from the moment the worker runs.
</div>

@if (Model.Saved is not null)
{
    <div class="alert alert-success" role="alert">@Model.Saved</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            @foreach (var error in Model.Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="row row-cards">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Configured symbols (@Model.Settings.Count)</h3>
            </div>
            @if (Model.Settings.Count == 0)
            {
                <div class="card-body text-secondary">Nothing is configured yet. Add the first symbol on the right.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead>
                            <tr><th>Exchange</th><th>Market</th><th>Symbol</th><th>Funding rate (from, UTC)</th><th>Liquidations</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var setting in Model.Settings)
                            {
                                <tr>
                                    <td>@Model.ExchangeName(setting.ExchangeId)</td>
                                    <td><span class="badge @(Model.MarketName(setting.MarketId) == "Futures" ? "bg-purple-lt" : "bg-blue-lt")">@Model.MarketName(setting.MarketId)</span></td>
                                    <td class="fw-bold">@Model.SymbolName(setting.SymbolId)</td>
                                    <td class="text-nowrap">
                                        @if (setting.CollectFundingRate)
                                        {
                                            <span class="badge bg-green-lt me-1">On</span>@setting.FundingStartDate?.ToString("yyyy-MM-dd")
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td>@if (setting.CollectLiquidation) { <span class="badge bg-green-lt">On</span> } else { <span class="text-secondary">-</span> }</td>
                                    <td class="text-nowrap text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-page="/SymbolData" asp-route-edit="@setting.Id">Edit</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-@setting.Id">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @foreach (var setting in Model.Settings)
                {
                <div class="modal modal-blur fade text-start" id="delete-@setting.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-sm modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body">
                                <div class="modal-title">Remove this setting?</div>
                                <div class="text-secondary">
                                    @Model.SymbolName(setting.SymbolId), @Model.MarketName(setting.MarketId).
                                    The stored funding rates and liquidations stay; the collector just stops collecting new ones.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn me-auto" data-bs-dismiss="modal">Cancel</button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@setting.Id">
                                    <button type="submit" class="btn btn-danger">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                }
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@(Model.IsEditing ? "Change setting" : "Add a symbol")</h3>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save" autocomplete="off" data-support-form>
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-3">
                        <label asp-for="Input.ExchangeId" class="form-label">Exchange</label>
                        <select asp-for="Input.ExchangeId" asp-items="Model.ExchangeItems" class="form-select" data-support-field="exchange">
                            <option value="0">Select...</option>
                        </select>
                        <span asp-validation-for="Input.ExchangeId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.MarketId" class="form-label">Market</label>
                        <select asp-for="Input.MarketId" asp-items="Model.MarketItems" class="form-select" data-support-field="market">
                            <option value="0">Select...</option>
                        </select>
                        <span asp-validation-for="Input.MarketId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.SymbolId" class="form-label">Symbol</label>
                        <select asp-for="Input.SymbolId" asp-items="Model.SymbolItems" class="form-select">
                            <option value="0">Select...</option>
                        </select>
                        <span asp-validation-for="Input.SymbolId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-check mb-1">
                            <input asp-for="Input.CollectFundingRate" type="checkbox" class="form-check-input" data-support-type="FundingRate" disabled="@(!Model.FundingRateAvailable)" />
                            <span class="form-check-label">Collect the funding rate</span>
                        </label>
                        <div class="form-hint mb-2">@Model.FundingRateRule The whole history is available.</div>
                        <label asp-for="Input.FundingStartDate" class="form-label">Funding rate from (UTC)</label>
                        <input asp-for="Input.FundingStartDate" type="date" class="form-control" data-follows="#Input_CollectFundingRate" />
                        <span asp-validation-for="Input.FundingStartDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-check mb-1">
                            <input asp-for="Input.CollectLiquidation" type="checkbox" class="form-check-input" data-support-type="Liquidation" disabled="@(!Model.LiquidationAvailable)" />
                            <span class="form-check-label">Collect liquidations</span>
                        </label>
                        <div class="form-hint">@Model.LiquidationRule At most one per second, so it is a sample, not a complete record.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">@(Model.IsEditing ? "Save changes" : "Add symbol")</button>
                        @if (Model.IsEditing)
                        {
                            <a class="btn" asp-page="/SymbolData">Cancel</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="market-data-support">@Json.Serialize(Model.Lookups.MarketDataSupport)</script>
