@page
@model TradingModel
@{
    ViewData["Title"] = "Demo trading";
}

@if (!Model.Configured)
{
    <div class="alert alert-info" role="alert">Trading is not part of this installation (<code>Trader:BaseUrl</code> is not set).</div>
    return;
}

<div class="alert alert-info" role="alert">
    <div><strong>This page is for testing, with a Demo key (play money).</strong> Real trading will have its own page.</div>
</div>

@if (Model.State is not null && !Model.HasDemoKey)
{
    <div class="alert alert-warning" role="alert">
        <div>You have no active Demo key, so nothing can be done here. Add one on <a asp-page="/ExchangeKeys">Exchange keys</a>
        (environment <strong>Demo</strong>) and wait until it shows <strong>Active</strong>.</div>
    </div>
    return;
}

@if (Model.Done is not null)
{
    <div class="alert alert-success" role="alert">@Model.Done</div>
}
@foreach (var error in Model.Errors)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.State is { } state)
{
    <div class="row row-cards">
        <div class="col-12 col-xl-5">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Status</h3>
                    <div class="card-actions">
                        @if (state.Halted)
                        {
                            <span class="badge bg-red-lt">HALTED</span>
                        }
                        else
                        {
                            <span class="badge bg-green-lt">Trading</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <dl class="row mb-3">
                        <dt class="col-6">Largest single order</dt><dd class="col-6">@state.MaxOrderUsd.ToString("0.##") USDT</dd>
                        <dt class="col-6">Opened today (UTC)</dt><dd class="col-6">@state.OpenedTodayUsd.ToString("0.##") of @state.MaxDailyUsd.ToString("0.##") USDT</dd>
                        <dt class="col-6">Symbols</dt><dd class="col-6">@(state.AllowedSymbols.Length == 0 ? "none enabled" : string.Join(", ", state.AllowedSymbols))</dd>
                    </dl>
                    <p class="text-secondary small">
                        These limits are set on the server, not here. While halted, no new position can be opened; an order marked
                        <em>only reduce</em> still goes through, so you can always get out.
                    </p>
                    @if (state.HaltedByServer)
                    {
                        <div class="alert alert-warning mb-0" role="alert">The server owner halted trading for everyone. It can only be lifted on the server.</div>
                    }
                    else if (state.Halted)
                    {
                        <form method="post" asp-page-handler="Resume">
                            <button type="submit" class="btn btn-outline-success w-100">Resume trading (asks for a code)</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Halt">
                            <button type="submit" class="btn btn-danger w-100">Halt trading now</button>
                        </form>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title">Symbols for trading</h3></div>
                <div class="card-body">
                    <p class="text-secondary small">
                        The server allows the symbols below and you choose which are enabled; nothing is enabled until somebody chooses it.
                        Enabling asks for a code, disabling is one click. A symbol you disable can still be closed (an order that only reduces a position always goes through).
                        <strong>Every enabled symbol is watched for sudden price moves on its own</strong> (<a asp-page="/ShockWatch">Price watch</a>); you can switch that off there, on your own responsibility.
                    </p>
                    @if (Model.Symbols.Count == 0)
                    {
                        <p class="text-secondary mb-0">The server allows no symbol.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var symbol in Model.Symbols)
                            {
                                <div class="list-group-item d-flex align-items-center px-0">
                                    <span class="fw-bold me-2">@symbol.Symbol</span>
                                    @if (symbol.Enabled)
                                    {
                                        <span class="badge bg-green-lt">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">Off</span>
                                    }
                                    <form method="post" class="ms-auto" asp-page-handler="@(symbol.Enabled ? "DisableSymbol" : "EnableSymbol")" asp-route-symbol="@symbol.Symbol">
                                        <button type="submit" class="btn btn-sm @(symbol.Enabled ? "btn-outline-secondary" : "btn-outline-primary")">@(symbol.Enabled ? "Disable" : "Enable (asks for a code)")</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h3 class="card-title">Market order</h3></div>
                <div class="card-body">
                    @if (state.AllowedSymbols.Length == 0)
                    {
                        <p class="text-secondary mb-0">No symbol is enabled for trading yet. Enable one above: a new position can only be opened in an enabled symbol.</p>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Order" autocomplete="off">
                            <div class="mb-3">
                                <label asp-for="Input.KeyId" class="form-label">Demo key</label>
                                @if (Model.DemoKeys.Count == 1)
                                {
                                    <input type="hidden" asp-for="Input.KeyId" value="@Model.DemoKeys[0].Id" />
                                    <div class="form-control-plaintext">@Model.DemoKeys[0].Label (Demo)</div>
                                }
                                else
                                {
                                    <select asp-for="Input.KeyId" class="form-select">
                                        @foreach (var key in Model.DemoKeys)
                                        {
                                            <option value="@key.Id">@key.Label (Demo)</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label asp-for="Input.Symbol" class="form-label">Symbol</label>
                                    <select asp-for="Input.Symbol" class="form-select">
                                        @foreach (var symbol in state.AllowedSymbols)
                                        {
                                            <option value="@symbol">@symbol</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6 mb-3">
                                    <label asp-for="Input.Side" class="form-label">Side</label>
                                    <select asp-for="Input.Side" class="form-select">
                                        <option value="BUY">Buy (long)</option>
                                        <option value="SELL">Sell (short)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Quantity" class="form-label">Quantity (in the coin, e.g. 0.001 BTC)</label>
                                <input asp-for="Input.Quantity" class="form-control" inputmode="decimal" />
                                <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                            </div>
                            <label class="form-check mb-3">
                                <input asp-for="Input.ReduceOnly" class="form-check-input" />
                                <span class="form-check-label">Only reduce an existing position (close)</span>
                            </label>
                            <button type="submit" class="btn btn-primary w-100">Send market order (asks for a code)</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Recent orders</h3></div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead><tr><th>Time (UTC)</th><th>Order</th><th>≈ USDT</th><th>Result</th></tr></thead>
                        <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="text-nowrap">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@order.Side @order.Quantity.ToString("0.########") @order.Symbol@(order.ReduceOnly ? " (reduce only)" : "")</td>
                                <td>@order.NotionalUsd.ToString("0.##")</td>
                                <td>
                                    @{
                                        var (badge, text) = order.Status switch
                                        {
                                            "Placed" => ("bg-green-lt", "Placed"),
                                            "Failed" => ("bg-red-lt", "Refused"),
                                            "Unknown" => ("bg-yellow-lt", "Unknown"),
                                            _ => ("bg-secondary-lt", order.Status)
                                        };
                                    }
                                    <span class="badge @badge">@text</span>
                                    @if (order.Error is not null) { <div class="text-secondary small">@order.Error</div> }
                                </td>
                            </tr>
                        }
                        @if (Model.Orders.Count == 0)
                        {
                            <tr><td colspan="4" class="text-secondary">No orders yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
