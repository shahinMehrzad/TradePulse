@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row row-cards">
    <div class="col-sm-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="subheader">Signed in as</div>
                <div class="h2 mb-1">@Model.Admin?.UserName</div>
                <div class="text-secondary">@Model.Admin?.Email</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card">
            <div class="card-body">
                <div class="subheader">Roles</div>
                <div class="h2 mb-1">@string.Join(", ", Model.Admin?.Roles ?? [])</div>
                <div class="text-secondary">Confirmed by the API just now</div>
            </div>
        </div>
    </div>
</div>
