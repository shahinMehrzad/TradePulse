{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=trading_db;Username=postgres;Password=password"
  },
  "BinanceExchangeConfigurations": {
    "MaxLimit": 5900    
  },
  "Alerts": {
    "InstanceName": "",
    "ConfirmationsToAlert": 2,
    "MaxPerHour": 20,
    "Telegram": { "BotToken": "", "ChatId": "" },
    "Email": { "Host": "", "Port": 587, "UseStartTls": true, "UserName": "", "Password": "", "From": "", "To": "" }
  },
  "Health": {
    "Enabled": true,
    "Url": "http://localhost:5080",
    "ProbeIntervalSeconds": 30,
    "ProbeSymbol": "BTCUSDT",
    "LiquidationMaxSilenceMinutes": 60,
    "SummaryIntervalMinutes": 10
  }
}
