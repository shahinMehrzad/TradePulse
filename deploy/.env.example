# Copy to deploy/.env and fill it in. deploy/.env is git-ignored: never commit real values.

# Database (the stack has its own Postgres; this is its password).
POSTGRES_PASSWORD=

# The key pair that signs and checks the tokens (ECDSA P-256). Make it with ./deploy/make-jwt-keys.sh, which prints both lines:
# JWT_PRIVATE_KEY goes to the API only (it is the only program that makes tokens), JWT_PUBLIC_KEY to the key vault (it can only check them).
# A hacked vault therefore cannot make a token for the API or the panel. JWT_SECRET of older versions is not used any more.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Passwords of the database roles. Every program has its own; none connects as the superuser (POSTGRES_PASSWORD) any more.
#   VAULT_DB_PASSWORD        the key vault's own Postgres ("vault-db")
#   API_DB_PASSWORD          role tp_api: the API (owns auth, config, research; reads the data tables)
#   COLLECTOR_DB_PASSWORD    role tp_collector: the collector (owns and writes the data tables)
#   TRADER_MAIN_DB_PASSWORD  role tp_trader: the key vault's way into the main database (audit log and the enabled symbols, nothing else)
# Letters and digits only, 16 or more, `openssl rand -hex 24`, all different from each other and from POSTGRES_PASSWORD.
# The roles are made by deploy/main-db-roles.sh (read docs/database-security.md for when to run it).
VAULT_DB_PASSWORD=
API_DB_PASSWORD=
COLLECTOR_DB_PASSWORD=
TRADER_MAIN_DB_PASSWORD=

# Encrypts the private keys of the users' exchange keys in the database (32 random bytes, base64: `openssl rand -base64 32`).
# Only the key vault (the "trader" service) gets it. Keep a copy somewhere that is NOT this server: without it every stored key is lost
# and the users have to make new ones. Changing it later does not re-encrypt what is stored.
VAULT_MASTER_KEY=

# Trading limits, enforced by the key vault ("trader" service); users of the panel cannot raise them. Real money is OFF until
# TRADING_ALLOW_LIVE=true (Demo keys trade either way). TRADING_HALTED=true stops every new position for everyone (restart to change).
# The caps are in USDT: one order at most TRADING_MAX_ORDER_USD, one user at most TRADING_MAX_DAILY_USD opened per UTC day.
TRADING_ALLOW_LIVE=false
TRADING_HALTED=false
TRADING_MAX_ORDER_USD=100
TRADING_MAX_DAILY_USD=500
TRADING_SYMBOL_1=BTCUSDT
TRADING_SYMBOL_2=ETHUSDT

# The administrator of the panel, created at the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Only with `--profile public` (HTTPS in front of the panel): the domain whose DNS A record points to this server, and an address
# for Let's Encrypt to warn about an expiring certificate.
DOMAIN=
ACME_EMAIL=

# Where the programs listen on this machine (only on 127.0.0.1).
PANEL_PORT=8088
API_PORT=8087
HEALTH_PORT=8089

# Alerts: leave a channel empty to leave it off. The name shows in every message.
ALERT_INSTANCE_NAME=tradepulse
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Security alerts (somebody is trying to get into an account: a second wrong two-factor code in a row, a lock after wrong codes or passwords) go to a
# bot of their own, so that a message in this chat always means that. Make it with @BotFather (/newbot), press Start in its chat, and give its
# token and the chat id (the same number as TELEGRAM_CHAT_ID when that is your own chat). Empty: only the audit log has the entry.
SECURITY_TELEGRAM_BOT_TOKEN=
SECURITY_TELEGRAM_CHAT_ID=
# The SMTP_* values (not SMTP_TO) also let users sign in with a code sent by email (My account); without SMTP_HOST and SMTP_FROM that is not offered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Watching and backups: deploy/watchdog.sh (every minute) and deploy/backup.sh (cron, see deploy/README.md).
# The watchdog pings this address while all is well, and <address>/fail while something is broken. Use a "dead man's switch" such as
# healthchecks.io (period 1 minute, grace 5 minutes) to hear about it when the pings stop: a dead server or a dead cron job.
WATCHDOG_PING_URL=
# Encrypt every backup (recommended): the PUBLIC key of an age key pair, `age1...` (62 characters). Whoever has a backup file but not the
# matching private key, which must not be on this server, can read nothing. The files then end in .age. Needs `sudo apt install age` on the
# server. How to make the key, the first test and the restore: docs/database-security.md ("Encrypted backups"). Empty: backups are plain.
BACKUP_AGE_RECIPIENT=
# How many backups stay on the server (of each kind), and where each one is copied off it (optional; rsync over ssh and/or an rclone remote).
BACKUP_KEEP=4
BACKUP_RSYNC_TARGET=
BACKUP_RCLONE_REMOTE=
